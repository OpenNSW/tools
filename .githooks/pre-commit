#!/usr/bin/env bash
#
# Native git pre-commit hook for github.com/OpenNSW/tools
# Enable once per clone:  git config core.hooksPath .githooks   (or: make setup)
#
# Runs against STAGED changes, in each tool module that has staged .go,
# go.mod or go.sum files. Auto-fixers (license headers, formatting) modify
# files and re-stage them so the fixes are part of the commit.
#
# Bypass everything:      git commit --no-verify
# Skip individual checks: SKIP=secrets,lint git commit
#   tokens: secrets license format lint mod build
#
# Partial staging: if you `git add -p` only some hunks of a .go file, the
# auto-fixers re-stage the WHOLE file. Stage whole .go files (or run
# `make fmt` first) to avoid pulling unstaged hunks into the commit.

set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Put tools installed with `go install` on PATH.
if [ -z "${GOPATH:-}" ] && command -v go >/dev/null 2>&1; then
  GOPATH="$(go env GOPATH)"
fi
if [ -n "${GOPATH:-}" ]; then
  export PATH="$GOPATH/bin:$PATH"
fi

LICENSE_TMPL="$REPO_ROOT/.github/license-header.tmpl"
GOLANGCI_CONFIG="$REPO_ROOT/.golangci.yml"
GOLANGCI_TIMEOUT="5m"

if [ -t 2 ]; then
  RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; BLD=$'\033[1m'; RST=$'\033[0m'
else RED=""; GRN=""; YLW=""; BLD=""; RST=""; fi
info() { printf '%s==>%s %s\n' "$BLD" "$RST" "$*" >&2; }
ok()   { printf '  %sok%s  %s\n' "$GRN" "$RST" "$*" >&2; }
warn() { printf '%swarn%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()  { printf '%sFAIL%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }
skip() { case ",${SKIP:-}," in *,"$1",*) return 0 ;; *) return 1 ;; esac; }

need_tool() {
  command -v "$1" >/dev/null 2>&1 || die "required tool '$1' not found.
       install: $2
       (or bypass once: git commit --no-verify)"
}

info "preflight: checking tools"
need_tool go            "https://go.dev/dl/ (>= 1.26)"
need_tool gitleaks      "brew install gitleaks  |  https://github.com/gitleaks/gitleaks/releases"
need_tool golangci-lint "make tools  (golangci-lint v2.15.0)"
need_tool addlicense    "make tools"

# 1. Secret scan (hard gate, before any auto-fix).
if skip secrets; then warn "SKIP=secrets"; else
  info "gitleaks: scanning staged changes"
  gitleaks git --staged --redact --no-banner \
    || die "gitleaks found a potential secret (above). Remove it or add an allow rule."
  ok "no secrets"
fi

# Staged .go, go.mod and go.sum files: Added/Copied/Modified/Renamed, NUL-safe.
STAGED=()
while IFS= read -r -d '' f; do STAGED+=("$f"); done \
  < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.go' '*/go.mod' '*/go.sum')

if [ "${#STAGED[@]}" -eq 0 ]; then
  ok "no staged Go files; skipping go checks"; exit 0
fi

# Each tool module is a top-level directory with a go.mod. Group the staged
# files by module; a .go file outside every module is refused.
MODULES=()
STAGED_GO=()
for f in "${STAGED[@]}"; do
  mod="${f%%/*}"
  if [[ "$mod" == "$f" || ! -f "$mod/go.mod" ]]; then
    die "$f is not in a tool module. Put each tool in <tool>/ with its own go.mod."
  fi
  [[ "$f" == *.go ]] && STAGED_GO+=("$f")
  case " ${MODULES[*]-} " in *" $mod "*) ;; *) MODULES+=("$mod") ;; esac
done
info "modules: ${MODULES[*]}"

# 2. License headers: add the SPDX header where missing, then re-stage.
if skip license; then warn "SKIP=license"; elif [ "${#STAGED_GO[@]}" -gt 0 ]; then
  info "addlicense: ensuring SPDX headers"
  addlicense -f "$LICENSE_TMPL" "${STAGED_GO[@]}"
  git add -- "${STAGED_GO[@]}"
  ok "headers ensured + re-staged"
fi

# 3. Format the staged .go files: gofmt + goimports via golangci-lint, run
# from each file's module, then re-stage.
if skip format; then warn "SKIP=format"; elif [ "${#STAGED_GO[@]}" -gt 0 ]; then
  info "golangci-lint fmt"
  for mod in "${MODULES[@]}"; do
    files=()
    for f in "${STAGED_GO[@]}"; do
      [[ "$f" == "$mod/"* ]] && files+=("${f#"$mod/"}")
    done
    [ "${#files[@]}" -gt 0 ] || continue
    (cd "$mod" && golangci-lint fmt -c "$GOLANGCI_CONFIG" "${files[@]}")
  done
  git add -- "${STAGED_GO[@]}"
  ok "formatted + re-staged"
fi

# 4. Lint each module with staged changes.
if skip lint; then warn "SKIP=lint"; else
  info "golangci-lint run"
  lint_ok=true
  for mod in "${MODULES[@]}"; do
    (cd "$mod" && golangci-lint run -c "$GOLANGCI_CONFIG" --timeout="$GOLANGCI_TIMEOUT" ./...) \
      || lint_ok=false
  done
  $lint_ok || die "lint issues (above). Fix and re-stage."
  ok "lint clean"
fi

# 5. go.mod/go.sum must be tidy (checked without changing them).
if skip mod; then warn "SKIP=mod"; else
  info "go mod tidy check"
  for mod in "${MODULES[@]}"; do
    go -C "$mod" mod tidy -diff \
      || die "$mod/go.mod or go.sum is not tidy (diff above). Run 'go -C $mod mod tidy', 'git add' them, recommit. Skip once: SKIP=mod"
  done
  ok "go.mod/go.sum tidy"
fi

# 6. Build each module with staged changes.
if skip build; then warn "SKIP=build"; else
  info "go build"
  for mod in "${MODULES[@]}"; do
    go -C "$mod" build ./... || die "go build failed in $mod (above)."
  done
  ok "build ok"
fi

ok "pre-commit passed"
